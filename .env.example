# Copy to .env in the project root. Loaded as Java Properties: no enclosing quotes.
IBM_SERVICE_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/REPLACE_ME
IBM_API_KEY=REPLACE_ME
IBM_ASSISTANT_ID=REPLACE_ME
IBM_ACTION_SKILL_ID=REPLACE_ME
IBM_DIALOG_SKILL_ID=REPLACE_ME
IBM_DRAFT_ENV_ID=REPLACE_ME
IBM_LIVE_ENV_ID=REPLACE_ME
# Optional for direct v1 workspace access; do not substitute a skill ID.
IBM_DIALOG_WORKSPACE_ID=
MYSQL_URL=jdbc:mysql://localhost:3306/tabula
MYSQL_USERNAME=REPLACE_ME
MYSQL_PASSWORD=REPLACE_ME
MONGODB_URI=mongodb://localhost:27017/tabula
MONGODB_DATABASE=tabula
# Local HTTP only; use true with HTTPS in production.
SESSION_COOKIE_SECURE=false
# Bootstrap is disabled in application.properties after initial provisioning.
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
