meta {
  name: 01-Criar-integracao-isolada
  type: http
  seq: 17
}

post {
  url: {{baseUrl}}/api/v1/portfolios/{{portfolioId}}/integrations
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Instancia IBM do portfolio",
    "serviceUrl": "{{ibmServiceUrl}}",
    "apiKey": "{{ibmApiKey}}"
  }
}

script:post-response {
  
  if (res.getStatus() < 300 && res.getBody().id) bru.setVar("integrationId", res.getBody().id);
}

tests {
  test("Status esperado", function () {
    expect([201]).to.include(res.getStatus());
  });
}

docs {
  Alternativa ao vinculo legado properties. OWNER pode cadastrar endpoint e API key proprios. Uma integracao por portfolio. A API key e criptografada no servidor e nao e devolvida. Configure as variaveis somente no ambiente local ignorado pelo Git.
}
