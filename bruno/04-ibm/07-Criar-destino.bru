meta {
  name: 07-Criar-destino
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/targets
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "integrationId": "{{integrationId}}", "configuration": {{targetConfiguration}} }
}

script:post-response {
  
  if (res.getStatus() < 300 && res.getBody().id) bru.setVar("targetId", res.getBody().id);
}

tests {
  test("Status esperado", function () {
    expect([201]).to.include(res.getStatus());
  });
}

docs {
  Execute individualmente, seguindo o README da collection.
}
