meta {
  name: 03-Renovar-CSRF
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/auth/csrf
  body: none
  auth: none
}

script:post-response {
  const b = res.getBody();
  if (res.getStatus() === 200) { bru.setVar("csrfToken", b.token); bru.setVar("csrfHeader", b.headerName); }
}

tests {
  test("Status esperado", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  Execute individualmente, seguindo o README da collection.
}
