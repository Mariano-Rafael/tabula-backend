meta {
  name: 02-Upload
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/flows
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{uploadKey}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Dialog local",
    "type": "DIALOG",
    "json": "{\"type\":\"dialog\",\"workspace\":{\"dialog_nodes\":[]}}"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().id) { bru.setVar("versionId", res.getBody().id); bru.setVar("flowId", res.getBody().flowId); }
}

tests {
  test("Status esperado", function () {
    expect([201,202]).to.include(res.getStatus());
  });
}

docs {
  Execute individualmente, seguindo o README da collection.
}
