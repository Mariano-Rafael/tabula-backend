meta {
  name: 01-Importar-ACTION
  type: http
  seq: 29
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/imports
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{importActionKey}}
  Content-Type: application/json
}

body:json {
  {
    "targetId": "{{targetId}}",
    "type": "ACTION",
    "name": "Importacao ACTION"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().id) { bru.setVar("versionId", res.getBody().id); bru.setVar("flowId", res.getBody().flowId); }
}

tests {
  test("Status esperado", function () {
    expect([201,202]).to.include(res.getStatus());
  });
}

docs {
  Pode retornar 202 IBM_EXPORT_PENDING. Repita com a mesma chave e corpo. Atualiza flowId/versionId; trabalhe em um fluxo por vez.
}
