meta {
  name: 01-Preparar-Draft
  type: http
  seq: 60
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/ibm-writes
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{writeKey}}
  Content-Type: application/json
}

body:json {
  {
    "targetId": "{{targetId}}",
    "versionId": "{{versionId}}"
  }
}

script:post-response {
  
  if (res.getStatus() < 300 && res.getBody().id) bru.setVar("writeId", res.getBody().id);
}

tests {
  test("Status esperado", function () {
    expect([201,202]).to.include(res.getStatus());
  });
}

docs {
  Prepara atualizacao da skill existente no Draft; nao envia mutacao. Usa uma versao local READY e armazena backup. Em IBM_EXPORT_PENDING repita mesma chave e corpo.
}
