meta {
  name: 01-Importar-DIALOG
  type: http
  seq: 31
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/imports
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{importDialogKey}}
  Content-Type: application/json
}

body:json {
  {
    "targetId": "{{targetId}}",
    "type": "DIALOG",
    "name": "Importacao DIALOG"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().versionId) { bru.setVar("versionId", res.getBody().versionId); bru.setVar("flowId", res.getBody().flowId); bru.setVar("versionEtag", '"' + res.getBody().version.revision + '"'); }
}

tests {
  test("Status esperado", function () {
    expect([201,202]).to.include(res.getStatus());
  });
}

docs {
  Pode retornar 202 IBM_EXPORT_PENDING. Repita com a mesma chave e corpo. Atualiza flowId/versionId; trabalhe em um fluxo por vez.
}
