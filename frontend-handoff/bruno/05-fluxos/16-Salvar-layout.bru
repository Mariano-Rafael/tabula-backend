meta {
  name: 16-Salvar-layout
  type: http
  seq: 47
}

put {
  url: {{baseUrl}}/api/v1/flows/{{flowId}}/layout
  body: json
  auth: none
}

headers {
  If-Match: {{layoutEtag}}
  Content-Type: application/json
}

body:json {
  {
    "schemaVersion": 1,
    "nodes": [
      {
        "id": "node_1",
        "position": {
          "x": 100,
          "y": 200
        },
        "collapsed": false
      }
    ],
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 1
    }
  }
}

script:post-response {
  if (res.getStatus() < 300) bru.setVar("layoutEtag", res.getHeader("etag"));
}

tests {
  test("Status esperado", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  Substitui integralmente o layout atual. ETag layout-N e independente do draftEtag. Nao envie data/edges ou o objeto completo do React Flow.
}
