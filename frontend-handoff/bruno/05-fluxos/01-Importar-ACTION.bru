meta {
  name: 01-Importar-ACTION
  type: http
  seq: 32
}

post {
  url: {{baseUrl}}/api/v1/projects/{{projectId}}/imports
  body: json
  auth: none
}

headers {
  Idempotency-Key: {{importActionKey}}
  Content-Type: application/json
}

body:json {
  {
    "targetId": "{{targetId}}",
    "type": "ACTION",
    "name": "Importacao ACTION"
  }
}

script:post-response {
  if (res.getStatus() < 300 && res.getBody().id) { bru.setVar("versionId", res.getBody().id); bru.setVar("flowId", res.getBody().flowId); }
}

tests {
  test("Status esperado", function () {
    expect(res.getStatus()).to.equal(422);
  });
}

docs {
  O novo editor inicia por Dialog classico. Importar ACTION como novo fluxo retorna 422 ACTION_EDITOR_NOT_IMPLEMENTED; dados Action legados continuam preservados.
}
