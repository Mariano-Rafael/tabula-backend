meta {
  name: 13-Rotacionar-credencial
  type: http
  seq: 30
}

put {
  url: {{baseUrl}}/api/v1/integrations/{{integrationId}}/credentials
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "apiKey": "{{ibmNextApiKey}}"
  }
}

tests {
  test("Status esperado", function () {
    expect([200]).to.include(res.getStatus());
  });
}

docs {
  Somente OWNER/admin, com CSRF. Substitui a API key de uma integracao DATABASE; endpoint nao muda. Invalidacao do cache ocorre na proxima chamada. Nao modifica a API key configurada no properties.
}
