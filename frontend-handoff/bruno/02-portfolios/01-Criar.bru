meta {
  name: 01-Criar
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/portfolios
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "name": "Portfolio Bruno",
    "description": "Testes manuais"
  }
}

script:post-response {
  
  if (res.getStatus() < 300 && res.getBody().id) bru.setVar("portfolioId", res.getBody().id);
}

tests {
  test("Status esperado", function () {
    expect([201]).to.include(res.getStatus());
  });
}

docs {
  Execute individualmente, seguindo o README da collection.
}
